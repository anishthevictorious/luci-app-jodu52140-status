{
    "luci-app-jodu52140-status": {
        "description": "Grant WebUI access to ODU 5G Dashboard",
        "read": {
            "uci": [ "jodu52140" ],
            "file": {
                "/usr/libexec/jodu52140-data.sh": [ "read", "exec" ],
                "/usr/libexec/jodu52140-reboot.sh": [ "exec" ],
                "/usr/libexec/jodu52140-at.sh": [ "exec" ],
                "/usr/libexec/jodu52140-lock.sh": [ "exec" ],
                "/usr/libexec/jodu52140-neighbor.sh": [ "exec" ],
                "/usr/libexec/jodu52140-neighbor-result.sh": [ "exec" ],
                "/usr/libexec/jodu52140-setup.sh": [ "exec" ],
                "/bin/sh": [ "exec" ]
            }
        },
        "write": {
            "uci": [ "jodu52140" ],
            "file": {
                "/tmp/odu_force_setup": [ "write" ],
                "/sbin/uci": [ "exec" ],
                "/bin/sh": [ "exec" ],
                "/usr/libexec/jodu52140-cron.sh": [ "exec" ],
                "/etc/crontabs/root": [ "write" ],
                "/etc/init.d/cron": [ "exec" ]
            }
        }
    }
}
